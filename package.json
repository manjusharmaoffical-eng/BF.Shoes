{
  "name": "bf-shoes-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "bootstrap-admin": "node src/bootstrap-admin.js",
    "test": "node --test test/*.test.js",
    "vercel-build": "if [ \"$VERCEL\" = \"1\" ] && [ \"$VERCEL_ENV\" = \"production\" ] && [ \"$RUN_MIGRATIONS\" = \"true\" ]; then node src/migrate.js; fi && find src frontend test -type f -name \"*.js\" -print0 | xargs -0 -n1 node --check && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
