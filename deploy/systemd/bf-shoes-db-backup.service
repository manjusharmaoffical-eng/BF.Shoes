[Unit]
Description=Create and verify a BF SHOES PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=bfshoes
Group=bfshoes
EnvironmentFile=/etc/bf-shoes/bf-shoes.env
ExecStart=/opt/bf-shoes/scripts/backup-db.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/bf-shoes
