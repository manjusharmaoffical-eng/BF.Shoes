# Template only. Copy to a private .env file and fill values in your hosting provider.
# Never commit .env files or share their contents in chat.
NODE_ENV=production
PORT=3000

# PostgreSQL connection; use a dedicated least-privilege application user.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10

# Generate a random secret with at least 32 bytes: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
TRUST_PROXY_HOPS=1
# Exact public origin(s), comma-separated; no wildcard.
ADMIN_ORIGIN=https://your-store-domain.example

# Optional AI product copy and image generation.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional persistent generated-image hosting (Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery (Resend); sender domain must be verified.
RESEND_API_KEY=
EMAIL_FROM=BF SHOES <orders@your-verified-domain.example>

# India market defaults. Keep tax/payment values unconfigured until verified.
INDIA_DELIVERY_PINCODES=500052
# Fee in paise. Blank means unknown; 0 means explicitly free delivery.
INDIA_DELIVERY_FEE_PAISE=
INDIA_GST_STATUS=unconfigured
