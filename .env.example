# Copy to .env and replace placeholders. Never commit .env.
NODE_ENV=production
PORT=3000

# PostgreSQL connection; use a dedicated least-privilege app user.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10

# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
TRUST_PROXY_HOPS=1
# Exact public origin(s), comma-separated; no wildcard.
ADMIN_ORIGIN=https://your-store-domain.example

# Optional AI product copy + image generation.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional persistent generated-image hosting (Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery (Resend). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=BF SHOES <orders@your-verified-domain.example>

# India checkout remains blocked until prices, actual delivery fee, GST profile and merchant setup are verified.
INDIA_DELIVERY_PINCODES=500052
# Fee in paise (100 paise = INR 1). Leave blank until confirmed; zero means explicitly free delivery.
INDIA_DELIVERY_FEE_PAISE=
INDIA_GST_STATUS=unconfigured
INDIA_PAYMENT_GATEWAY=payu
INDIA_PAYMENT_METHODS=payu
INDIA_PRICING_VERIFIED=false
INDIA_DELIVERY_FEE_VERIFIED=false
INDIA_CHECKOUT_VERIFIED=false

# PayU India hosted checkout. Keep credentials blank until issued by the verified merchant account.
PAYU_ENABLED=false
PAYU_ENV=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PUBLIC_BASE_URL=https://bfshoes.online
