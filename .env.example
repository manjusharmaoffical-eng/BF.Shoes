# Copy to .env and replace placeholders. Never commit .env.
NODE_ENV=production
PORT=3000

# PostgreSQL connection; use a dedicated least-privilege app user.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10

# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
TRUST_PROXY_HOPS=1
# Exact public origin(s), comma-separated; no wildcard.
ADMIN_ORIGIN=https://your-store-domain.example

# Optional AI product copy + image generation.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional persistent generated-image hosting (Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery (Resend). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=BF SHOES <orders@your-verified-domain.example>

# India checkout remains blocked until prices are verified in INR and the actual fee is confirmed.
INDIA_DELIVERY_PINCODES=500052
# Fee in paise (100 paise = INR 1). Leave blank until confirmed; zero means explicitly free delivery.
INDIA_DELIVERY_FEE_PAISE=
# Supported storefront payment method(s). COD is implemented; enable only when delivery supports it.
# registered or not_registered, only after verifying the seller legal/tax status.
INDIA_GST_STATUS=unconfigured

# Both methods are planned; online is not enabled until a real gateway is integrated and verified.
# registered or not_registered after confirming the legal seller GST status.
INDIA_GST_STATUS=unconfigured
# Leave blank until a merchant gateway is selected and its integration is completed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Both are intended; online remains disabled until gateway integration and verification are complete.
INDIA_PAYMENT_METHODS=cod,online
# registered or not_registered only after confirming the seller GST status.
INDIA_GST_STATUS=unconfigured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

INDIA_PAYMENT_GATEWAY=razorpay
